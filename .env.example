# Frontend (Vercel). Nenhum secret com prefixo NEXT_PUBLIC_.

# URL pública do Worker de controle. Sem isso o BFF /api/mipede/* responde 503.
MIPEDE_CONTROL_API_URL=

# Segredo compartilhado BFF ↔ Worker. Nunca usar NEXT_PUBLIC_.
MIPEDE_BFF_SHARED_SECRET=

# 1 = protótipo visual. Produção deve ficar em 0 depois da autenticação real.
MIPEDE_ALLOW_DEMO=0

# Site key pública do Turnstile (não é secret). O secret fica só no Worker.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Métodos públicos. A fonte da verdade é o Worker.
# GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET ficam somente no Worker.
